TZ=America/Santiago

# Edge host ports
MQTT_PORT=1883
Z2M_UI_PORT=8084
NODERED_PORT=1880

# MQTT local credentials
MQTT_USER=iot
MQTT_PASS=change-me-strong-password

# Real host path for Zigbee adapter (by-id)
# Get with: ls -l /dev/serial/by-id/
ZIGBEE_ADAPTER_HOST=/dev/serial/by-id/usb-XXXXX

# Optional UID/GID (rootless)
PUID=1000
PGID=1000

# ThingsBoard cloud target for Node-RED gateway flow
TB_CLOUD_HOST=thingsboard.example.com
TB_CLOUD_MQTT_PORT=1883
TB_GATEWAY_TOKEN=replace-me

# Backup
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=7
