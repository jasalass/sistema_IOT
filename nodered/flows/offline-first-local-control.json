  {
    "id": "fn_extract_switch_state",
    "type": "function",
    "z": "7d2eb93b29f9d001",
    "name": "Parse estado switch",
    "func": "const target = (env.get(\"EDGE_SWITCH_DEVICE\") || \"Switch Zigbee\").trim();\nif (msg.topic !== `zigbee2mqtt/${target}`) return null;\n\nlet data = msg.payload;\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { return null; }\n}\nif (!data || typeof data !== \"object\" || data.state === undefined) return null;\n\nconst on = String(data.state).toUpperCase() === \"ON\";\nflow.set(\"local_switch_state\", on);\nreturn { payload: on, topic: target };",
    "outputs": 1,
    "noerr": 0,
    "x": 410,
    "y": 120,
    "wires": [
      [
        "ui_switch_local",
        "fn_local_state_text"
      ]
    ]
  },
