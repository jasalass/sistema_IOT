  {
    "id": "mqtt_in_tb_raw",
    "type": "mqtt in",
    "z": "7d2eb93b29f9d001",
    "name": "Raw Z2M para cloud",
    "topic": "zigbee2mqtt/#",
    "qos": "0",
    "datatype": "auto",
    "broker": "mqtt_broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 420,
