  {
    "id": "fn_to_tb_payload",
    "type": "function",
    "z": "7d2eb93b29f9d001",
    "name": "Map Z2M -> TB Gateway",
    "func": "if (!msg.topic || !msg.topic.startsWith(\"zigbee2mqtt/\")) return null;\nconst device = msg.topic.replace(\"zigbee2mqtt/\", \"\");\nif (!device || device.startsWith(\"bridge\") || device.endsWith(\"/set\")) return null;\n\nlet data = msg.payload;\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { return null; }\n}\nif (!data || typeof data !== \"object\") return null;\n\nconst values = {};\nfor (const [k, v] of Object.entries(data)) {\n  if (v === null || v === undefined) continue;\n  if ([\"number\", \"boolean\", \"string\"].includes(typeof v)) {\n    values[k] = v;\n  }\n}\nif (Object.keys(values).length === 0) return null;\n\nmsg.topic = \"v1/gateway/telemetry\";\nmsg.payload = {\n  [device]: [{\n    ts: Date.now(),\n    values\n  }]\n};\nmsg.qos = 1;\nmsg.retain = false;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 430,
    "y": 420,
    "wires": [
      [
        "fn_queue_or_send"
      ]
    ]
  },
  {
    "id": "fn_queue_or_send",
    "type": "function",
    "z": "7d2eb93b29f9d001",
    "name": "Queue when cloud offline",
    "func": "const connected = global.get(\"tb_cloud_connected\") === true;\nconst queue = flow.get(\"tb_queue\") || [];\n\nif (connected) {\n  return [msg, null];\n}\n\nqueue.push({ topic: msg.topic, payload: msg.payload, qos: 1, retain: false });\nif (queue.length > 5000) queue.shift();\nflow.set(\"tb_queue\", queue);\nreturn [null, { payload: `Cloud OFFLINE - cola: ${queue.length}` }];",
    "outputs": 2,
    "noerr": 0,
    "x": 690,
    "y": 420,
    "wires": [
      [
        "mqtt_out_tb"
      ],
      [
        "ui_text_cloud"
      ]
    ]
  },
