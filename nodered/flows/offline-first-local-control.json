  {
    "id": "fn_build_switch_cmd",
    "type": "function",
    "z": "7d2eb93b29f9d001",
    "name": "Build comando ON/OFF",
    "func": "const target = (env.get(\"EDGE_SWITCH_DEVICE\") || \"Switch Zigbee\").trim();\nconst on = msg.payload === true || String(msg.payload).toUpperCase() === \"ON\";\nmsg.topic = `zigbee2mqtt/${target}/set`;\nmsg.payload = { state: on ? \"ON\" : \"OFF\" };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 880,
    "y": 120,
    "wires": [
      [
        "mqtt_out_switch_cmd",
        "fn_local_cmd_text"
      ]
