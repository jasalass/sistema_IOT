  {
    "id": "fn_extract_sensor",
    "type": "function",
    "z": "7d2eb93b29f9d001",
    "name": "Parse sensor T/H",
    "func": "const target = (env.get(\"EDGE_SENSOR_DEVICE\") || \"Sensor humedad/temperatura\").trim();\nif (msg.topic !== `zigbee2mqtt/${target}`) return null;\n\nlet data = msg.payload;\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { return null; }\n}\nif (!data || typeof data !== \"object\") return null;\n\nconst out1 = data.temperature !== undefined ? { payload: Number(data.temperature) } : null;\nconst out2 = data.humidity !== undefined ? { payload: Number(data.humidity) } : null;\nreturn [out1, out2];",
    "outputs": 2,
    "noerr": 0,
    "x": 380,
    "y": 260,
    "wires": [
      [
        "ui_gauge_temp"
      ],
      [
        "ui_gauge_hum"
      ]
    ]
