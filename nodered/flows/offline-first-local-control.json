  {
    "id": "fn_tb_status",
    "type": "function",
    "z": "7d2eb93b29f9d001",
    "name": "Set cloud status",
    "func": "const txt = ((msg.status && msg.status.text) || \"\").toLowerCase();\nconst connected = txt.includes(\"connected\");\nglobal.set(\"tb_cloud_connected\", connected);\nconst queue = flow.get(\"tb_queue\") || [];\nmsg.payload = connected ? `Cloud ONLINE - cola: ${queue.length}` : `Cloud OFFLINE - cola: ${queue.length}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 420,
    "y": 500,
    "wires": [
      [
        "ui_text_cloud"
      ]
    ]
  },
