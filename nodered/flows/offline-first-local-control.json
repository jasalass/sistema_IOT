  {
    "id": "inject_flush_queue",
    "type": "inject",
    "z": "7d2eb93b29f9d001",
    "name": "Flush cada 15s",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "15",
    "crontab": "",
    "once": true,
    "onceDelay": "5",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 170,
    "y": 580,
    "wires": [
      [
        "fn_flush_queue"
      ]
    ]
  },
  {
    "id": "fn_flush_queue",
    "type": "function",
    "z": "7d2eb93b29f9d001",
    "name": "Flush cola",
    "func": "if (global.get(\"tb_cloud_connected\") !== true) return null;\nconst queue = flow.get(\"tb_queue\") || [];\nif (!queue.length) return null;\n\nconst batch = queue.splice(0, 50);\nflow.set(\"tb_queue\", queue);\n\nconst out = batch.map(item => ({\n  topic: item.topic,\n  payload: item.payload,\n  qos: 1,\n  retain: false\n}));\n\nreturn [out, { payload: `Cloud ONLINE - enviados ${batch.length}, pendientes ${queue.length}` }];",
    "outputs": 2,
    "noerr": 0,
    "x": 390,
    "y": 580,
    "wires": [
      [
        "mqtt_out_tb"
      ],
      [
        "ui_text_cloud"
      ]
    ]
  }
