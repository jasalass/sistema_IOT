    "name": "Temp > 30C",
    "property": "payload.temperature",
    "propertyType": "msg",
    "rules": [
      { "t": "gt", "v": "30", "vt": "num" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 560,
    "y": 120,
    "wires": [
      [
