  {
    "id": "fn_telegram",
    "type": "function",
    "z": "f2c2b2b7f9c9c002",
    "name": "Build Telegram message",
    "func": "var dev = msg.topic.replace('zigbee2mqtt/','');\nvar temp = msg.payload.temperature;\nmsg.headers = { 'content-type': 'application/json' };\nmsg.payload = {\n  chat_id: '<TELEGRAM_CHAT_ID>',\n  text: 'Alerta: ' + dev + ' temperatura ' + temp + 'C'\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 780,
    "y": 120,
    "wires": [
      [
        "http_telegram"
      ]
    ]
  },
  {
    "id": "http_telegram",
    "type": "http request",
    "z": "f2c2b2b7f9c9c002",
    "name": "Send Telegram",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/sendMessage",
